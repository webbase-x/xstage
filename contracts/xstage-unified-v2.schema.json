{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/webbase-x/xstage/blob/main/contracts/xstage-unified-v2.schema.json",
  "title": "X-Stage Unified Song Catalog V2",
  "description": "Portable song metadata. Cloud references use fileId; local references use localPath. Storage itself remains platform-specific.",
  "oneOf": [
    {
      "$ref": "#/$defs/catalog"
    },
    {
      "$ref": "#/$defs/song"
    },
    {
      "$ref": "#/$defs/pointer"
    }
  ],
  "$defs": {
    "locator": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "fileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "localPath": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "md5Checksum": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{32}$"
        }
      },
      "oneOf": [
        {
          "required": [
            "fileId"
          ],
          "not": {
            "required": [
              "localPath"
            ]
          }
        },
        {
          "required": [
            "localPath"
          ],
          "not": {
            "required": [
              "fileId"
            ]
          }
        }
      ]
    },
    "midi": {
      "allOf": [
        {
          "$ref": "#/$defs/locator"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "ncn",
                "emk"
              ]
            },
            "lyr": {
              "$ref": "#/$defs/locator"
            },
            "cur": {
              "$ref": "#/$defs/locator"
            }
          },
          "required": [
            "type"
          ],
          "if": {
            "properties": {
              "type": {
                "const": "ncn"
              }
            }
          },
          "then": {
            "required": [
              "lyr",
              "cur"
            ]
          }
        }
      ]
    },
    "video": {
      "allOf": [
        {
          "$ref": "#/$defs/locator"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "avi",
                "mpg",
                "vcd",
                "wmv",
                "mp4"
              ]
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "song": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "webSongId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "artist": {
          "type": "string"
        },
        "media": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "mp3": {
              "$ref": "#/$defs/locator"
            },
            "m4a": {
              "$ref": "#/$defs/locator"
            },
            "midi": {
              "$ref": "#/$defs/midi"
            },
            "video": {
              "$ref": "#/$defs/video"
            }
          }
        },
        "lyrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/locator"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "code",
        "title",
        "artist",
        "media"
      ]
    },
    "catalog": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "format": {
          "const": "xstage-unified-v2"
        },
        "generation": {
          "type": "string"
        },
        "songs": {
          "type": "array",
          "maxItems": 1000000,
          "items": {
            "$ref": "#/$defs/song"
          }
        }
      },
      "required": [
        "schemaVersion",
        "songs"
      ],
      "additionalProperties": true
    },
    "pointer": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "format": {
          "const": "xstage-unified-v2"
        },
        "generation": {
          "type": "string",
          "minLength": 1
        },
        "catalogFileId": {
          "type": "string",
          "minLength": 1
        },
        "songCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "required": [
        "schemaVersion",
        "generation",
        "catalogFileId",
        "songCount"
      ],
      "additionalProperties": true
    }
  }
}
