<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>XStageMirrorIOSPC</AssemblyName>
    <RootNamespace>XStageMirrorIOSPC</RootNamespace>
    <Version>1.0.6</Version>
    <FileVersion>1.0.6.1007</FileVersion>
    <ApplicationTitle>X-Stage Mirror iOS PC</ApplicationTitle>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <PlatformTarget>x64</PlatformTarget>
    <PublishAot>false</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="logo.png" LogicalName="XStageMirrorIOSPC.logo.png" />
  </ItemGroup>
</Project>
