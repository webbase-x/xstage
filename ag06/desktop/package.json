{
  "name": "xstage-audio-studio-desktop",
  "productName": "X-Stage Audio Studio",
  "version": "0.1.0",
  "private": true,
  "main": "main.cjs",
  "description": "USB audio recording and software DSP studio; compatible with supported audio interfaces",
  "scripts": {
    "start": "electron .",
    "dist": "node tools/make_icon.cjs && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.webbasex.ag06studio",
    "productName": "X-Stage Audio Studio",
    "files": [
      "main.cjs",
      "package.json",
      "icon.ico",
      "tools/make_icon.cjs"
    ],
    "extraResources": [
      {
        "from": "../",
        "to": "ag06-web",
        "filter": [
          "index.html",
          "app.js",
          "audio-engine.js",
          "studio-session.js",
          "studio-advanced.js",
          "presets.js",
          "style.css",
          "icon.svg"
        ]
      }
    ],
    "win": {
      "target": "portable",
      "artifactName": "X-Stage-Audio-Studio-v${version}-Windows.exe",
      "icon": "icon.ico"
    },
    "directories": {
      "output": "dist"
    }
  }
}
