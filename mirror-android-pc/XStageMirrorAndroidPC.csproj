<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType>
  <TargetFramework>net8.0-windows</TargetFramework>
  <UseWindowsForms>true</UseWindowsForms>
  <ImplicitUsings>enable</ImplicitUsings>
  <Nullable>enable</Nullable>
  <AssemblyName>XStageMirrorAndroidPC</AssemblyName>
  <RootNamespace>XStageMirrorAndroidPC</RootNamespace>
  <Version>1.0.6</Version>
  <FileVersion>1.0.6.1007</FileVersion>
  <ApplicationTitle>X-Stage Mirror Android PC</ApplicationTitle>
  <PlatformTarget>x64</PlatformTarget>
   <ApplicationIcon>app.ico</ApplicationIcon>
  <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
 </PropertyGroup>
 <ItemGroup>
  <EmbeddedResource Include="logo.png" LogicalName="XStageMirrorAndroidPC.logo.png" />
 </ItemGroup>
</Project>
